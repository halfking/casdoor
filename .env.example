# ============================================
# 开轩平台 Casdoor 认证服务 - 兼容环境变量参考
# 标准部署入口已切换到 deployment/platform.env.example
# 本文件仅保留给旧的本地联调场景参考，不再作为部署真相源
# ============================================

# --- 数据库 ---
CASDOOR_DB_PASS=change-me-before-deploy
CASDOOR_ADMIN_PASS=change-me-before-deploy

# --- ACC 控制中心 ---
ACC_PUBLIC_URL=http://localhost:4100
CASDOOR_CLIENT_ID=replace-acc-client-id
CASDOOR_CLIENT_SECRET=replace-acc-client-secret

# --- Official Portal ---
PORTAL_URL=http://localhost:8080
PORTAL_CASDOOR_CLIENT_ID=replace-portal-client-id
PORTAL_CASDOOR_CLIENT_SECRET=replace-portal-client-secret

# --- KxMemory (Memora) ---
KXMEMORY_URL=http://localhost:8001
CASDOOR_KXMEMORY_CLIENT_ID=replace-kxmemory-client-id
CASDOOR_KXMEMORY_CLIENT_SECRET=replace-kxmemory-client-secret

# --- Stock Trading (Finance AI) ---
STOCK_URL=http://localhost:8090
CASDOOR_STOCK_CLIENT_ID=replace-stock-client-id
CASDOOR_STOCK_CLIENT_SECRET=replace-stock-client-secret

# --- Doc Tools ---
DOCTOOLS_URL=http://localhost:8200
CASDOOR_DOCTOOLS_CLIENT_ID=replace-doc-tools-client-id
CASDOOR_DOCTOOLS_CLIENT_SECRET=replace-doc-tools-client-secret

# --- TrendRadar ---
TRENDARADAR_URL=http://localhost:8081/trendaradar
CASDOOR_TRENDARADAR_CLIENT_ID=replace-trendaradar-client-id
CASDOOR_TRENDARADAR_CLIENT_SECRET=replace-trendaradar-client-secret

# --- Personal (个人助手) ---
PERSONAL_WEB_URL=https://personal.itestu.cn
PERSONAL_API_URL=https://api.personal.itestu.cn
CASDOOR_PERSONAL_CLIENT_ID=replace-personal-client-id
CASDOOR_PERSONAL_CLIENT_SECRET=replace-personal-client-secret

# --- AICMS ---
AICMS_URL=https://aicms.itestu.cn
CASDOOR_AICMS_CLIENT_ID=replace-aicms-client-id
CASDOOR_AICMS_CLIENT_SECRET=replace-aicms-client-secret
